# Read by both hosts (Netlify and Cloudflare Workers assets); never served as a file.
# The service worker must always be revalidated, or players stay pinned to an old build
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

# Lagos Life (Vatar Games) shows the game in a frame inside its own pages (src/vatar.js); nobody else may frame it
/*
  Content-Security-Policy: frame-ancestors 'self' https://lagoslife.app https://www.lagoslife.app https://naijalife.app https://www.naijalife.app https://lagoslife.eliysites.com
