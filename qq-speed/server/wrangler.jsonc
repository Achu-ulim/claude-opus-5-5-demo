// Driftbolt multiplayer server. Local: npm run mp:dev · Deploy: npm run mp:deploy (both from qq-speed/)
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "driftbolt-mp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] }],
  "vars": {
    // pages allowed to open a connection (* = one host label or a port); the game's Netlify site and its deploy previews, plus local dev
    "ALLOWED_ORIGINS": "https://driftbolt.netlify.app,https://*--driftbolt.netlify.app,http://localhost:*,http://127.0.0.1:*"
  }
}
