// Driftbolt on Cloudflare: one Worker serves the game (dist/) and runs the online play server (server/src/index.js).
// Local: npm run preview (http://localhost:8787) · Deploy: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftbolt",
  "main": "server/src/index.js",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  // the game's own domain (bought at Hostinger, DNS on Cloudflare); it also stays on driftbolt.driftbolt.workers.dev
  // keep the workers.dev address too: the Netlify copy's game server lives there
  "workers_dev": true,
  "routes": [
    { "pattern": "driftbolt.online", "custom_domain": true },
    { "pattern": "www.driftbolt.online", "custom_domain": true }
  ],
  // the game is rebuilt before every deploy and dev session; MP_URL=/ points it at the server on its own host
  "build": { "command": "MP_URL=/ node build.mjs", "watch_dir": ["src", "public"] },
  // files in dist/ are served as they are; anything else (/ws, /presence, /league, /health) reaches the Worker
  "assets": { "directory": "dist" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "LEAGUES", "class_name": "League" },
      // every player account (one global instance)
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      // how many players have the game open (one global instance)
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] },
    { "tag": "v2", "new_sqlite_classes": ["League"] },
    { "tag": "v3", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v4", "new_sqlite_classes": ["Presence"] }
  ],
  // Accounts also need these secrets (npx wrangler secret put <NAME>): AUTH_SECRET, a long random string that signs
  // sessions (openssl rand -base64 48), EMAIL_API_KEY if EMAIL_PROVIDER is "resend", and PAYSTACK_SECRET_KEY for payments.
  // For "cloudflare", add the Email Service binding instead: "send_email": [{ "name": "EMAIL" }].
  // Local dev reads both from .dev.vars (see .dev.vars.example).
  "vars": {
    // other pages allowed to connect, and to call /league and /auth with CORS (the game served by this Worker always is); * = one host label or a port.
    // The Netlify copy of the game and its deploy previews, plus local dev
    "ALLOWED_ORIGINS": "https://driftbolt.netlify.app,https://*--driftbolt.netlify.app,http://localhost:*,http://127.0.0.1:*",
    // how login codes are emailed: "resend" or "cloudflare" (server/src/mail.js). Empty: no emails, so only devices
    // that already have a device token can log in. Resend only sends once driftbolt.online is verified at resend.com/domains
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Driftbolt <login@driftbolt.online>",
    // Paystack, for buying tokens (server/src/pay.js). The secret key is a secret: npx wrangler secret put PAYSTACK_SECRET_KEY.
    // Without it, buying is off. In Paystack's dashboard, set the webhook URL to https://driftbolt.online/paystack/webhook.
    // The public key isn't needed by the game's checkout (the server opens each payment and hands over an access code).
    "PAYSTACK_PUBLIC_KEY": ""
  }
}
